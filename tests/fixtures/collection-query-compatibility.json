  "sources": {
    "int": "ENTITY User\nid INT PRIMARY KEY\nname STRING REQUIRED",
    "string": "ENTITY User\nkey STRING PRIMARY KEY\nname STRING",
    "implicit": "ENTITY Item\nname STRING",
    "relationship": "// APIForge DSL Sample with Relationship\n// Demonstrates entities and relationship declaration\n\nENTITY Student\n\nid INT PRIMARY KEY\nname STRING REQUIRED\n\nENTITY Course\n\nid INT PRIMARY KEY\ntitle STRING REQUIRED\n\nRELATION Student ENROLLS_IN Course MANY_TO_MANY\n",
    "length": "// ============================================\n// APIForge DSL - STRING Length Validation\n// File: string_length_validation.apiforge\n// ============================================\n\nENTITY User\n\n    id       INT    PRIMARY KEY\n    username STRING REQUIRED UNIQUE MIN_LENGTH 3 MAX_LENGTH 20\n    bio      STRING MAX_LENGTH 500\n    role     STRING DEFAULT \"student\" MIN_LENGTH 3 MAX_LENGTH 20\n",
    "enum": "// ENUM values are case-sensitive strings in declaration order.\nENTITY Account\nid INT PRIMARY KEY\nemail STRING REQUIRED UNIQUE\nstatus ENUM(\"active\", \"suspended\", \"closed\") DEFAULT \"active\"\nrole ENUM(\"student\", \"faculty\", \"admin\") REQUIRED\n",
    "types": "ENTITY Student\nid INT PRIMARY KEY\nname STRING REQUIRED\nage INT MIN 18 MAX 60\ncgpa FLOAT\nactive BOOLEAN DEFAULT TRUE\nstatus ENUM(\"active\", \"inactive\", \"suspended\") DEFAULT \"active\"",
    "reserved": "ENTITY Record\nkey STRING PRIMARY KEY\norder STRING\npage INT\nlimit INT\nsort STRING"
  },
